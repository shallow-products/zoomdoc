{
  "asyncapi": "2.6.0",
  "info": {
    "title": "Order Events",
    "version": "1.3.0",
    "description": "注文ドメインが発行するイベントのスキーマ。購読側は冪等に処理すること。"
  },
  "channels": {
    "order.created": {
      "description": "注文が作成された",
      "publish": {
        "message": {
          "payload": {
            "type": "object"
          }
        }
      }
    },
    "order.paid": {
      "description": "決済が完了した",
      "publish": {
        "message": {
          "payload": {
            "type": "object"
          }
        }
      }
    },
    "order.shipped": {
      "description": "出荷された",
      "publish": {
        "message": {
          "payload": {
            "type": "object"
          }
        }
      }
    },
    "order.cancelled": {
      "description": "キャンセルされた",
      "publish": {
        "message": {
          "payload": {
            "type": "object"
          }
        }
      }
    },
    "order.refunded": {
      "description": "返金された",
      "publish": {
        "message": {
          "payload": {
            "type": "object"
          }
        }
      }
    }
  }
}
